#!/bin/bash

for file in *.{c,js,py}; do

    [ -e "$file" ] || continue

    first_line=$(head -n 1 "$file")

    if echo "$first_line" | grep -qE '^(\/\/|\/\*|#)'; then
        echo "$file"
    fi
done

